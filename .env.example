# 백엔드(RoutineSlim-Server) 주소. 이 파일을 .env.local 로 복사해서 값을 바꾼다 (.env.local 은 git 에 올라가지 않음)
# - 웹(브라우저)·iOS 시뮬레이터: http://localhost:8080 (값을 비워 두면 이 주소)
# - 안드로이드 에뮬레이터: http://10.0.2.2:8080
# - 휴대폰 Expo Go: http://<PC 의 IPv4 주소>:8080 (ipconfig 로 확인, 같은 와이파이 + 방화벽 8080 허용)
EXPO_PUBLIC_API_URL=http://localhost:8080

# [소셜 로그인 - 권기쁨] 구글 OAuth Client ID (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
# - 웹: "OAuth 클라이언트 ID > 웹 애플리케이션" 으로 만들고
#       승인된 JavaScript 원본: http://localhost:8081 / 승인된 리디렉션 URI: http://localhost:8081
# - 안드로이드·iOS: 각 플랫폼 유형으로 따로 만든다 (패키지 이름·번들 ID 필요, 개발 빌드에서만 동작. Expo Go 는 불가)
# Client ID 는 공개돼도 되는 값이지만, Client Secret 은 앱에 넣지 않는다
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
